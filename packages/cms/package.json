{
  "name": "@blaze-cms/cms",
  "version": "0.1.0",
  "type": "module",
  "bin": "bin/cms.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
